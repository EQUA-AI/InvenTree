{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "paths": {
      "@babel/core": ["./node_modules/@types/babel__core/index.d.ts"],
      "@babel/traverse": ["./node_modules/@types/babel__traverse/index.d.ts"]
    },
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "version-info.ts",
    "vite.config.ts"
  ]
}
