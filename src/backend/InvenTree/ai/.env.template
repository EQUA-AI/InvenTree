# =============================================================================
# AIMMS Backend Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
AIMMS_ENV=development
AIMMS_DEBUG=true
AIMMS_LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
AIMMS_HOST=0.0.0.0
AIMMS_PORT=8080

# -----------------------------------------------------------------------------
# Azure AI Foundry / OpenAI Configuration
# -----------------------------------------------------------------------------
# Primary model endpoint (GPT-4o recommended)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Fast model for T1 routing (GPT-4o-mini)
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-4o-mini

# -----------------------------------------------------------------------------
# Azure Document Intelligence
# -----------------------------------------------------------------------------
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your-key

# -----------------------------------------------------------------------------
# Azure Foundry Memory Store (for long-term memory)
# -----------------------------------------------------------------------------
AZURE_FOUNDRY_MEMORY_ENDPOINT=https://your-resource.memory.azure.com/
AZURE_FOUNDRY_MEMORY_KEY=your-key

# -----------------------------------------------------------------------------
# Azure AI Search (for conversation semantic/vector search)
# -----------------------------------------------------------------------------
# Required for conversation persistence and semantic search
AZURE_AI_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net
AZURE_AI_SEARCH_KEY=your-search-admin-key
# Index name for storing conversation messages (will be created if not exists)
AZURE_AI_SEARCH_INDEX_NAME=aimms-conversations

# Also supports these aliases for consistency:
AZURE_SEARCH_ENDPOINT=https://your-search-resource.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=inventree-ai-conversations

# -----------------------------------------------------------------------------
# Conversation Persistence Configuration
# -----------------------------------------------------------------------------
# Enable PostgreSQL persistence for conversations
CONVERSATION_PERSISTENCE_ENABLED=true
# Enable Azure AI Search indexing for semantic search
CONVERSATION_SEARCH_ENABLED=true
# Batch size for syncing unindexed messages
CONVERSATION_SYNC_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# InvenTree Configuration
# -----------------------------------------------------------------------------
INVENTREE_URL=http://localhost:8000/api/
INVENTREE_TOKEN=your-inventree-api-token
INVENTREE_TIMEOUT=30

# -----------------------------------------------------------------------------
# Gmail Integration
# -----------------------------------------------------------------------------
# Email account for parts inbox
GMAIL_EMAIL=parts@equa.work
# Path to Google service account credentials JSON
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google-service-account.json
# Gmail API scopes (comma-separated)
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify

# -----------------------------------------------------------------------------
# Storage Paths (File-based for v1)
# -----------------------------------------------------------------------------
AIMMS_DATA_DIR=./data
AIMMS_THREADS_DIR=./data/threads
AIMMS_CHECKPOINTS_DIR=./data/checkpoints
AIMMS_CACHE_DIR=./data/cache

# -----------------------------------------------------------------------------
# Semantic Cache Configuration
# -----------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# HITL (Human-in-the-Loop) Configuration
# -----------------------------------------------------------------------------
HITL_TIMEOUT_SECONDS=300
HITL_AUTO_REJECT_ON_TIMEOUT=false

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for the AI chat API
# In production, set this to your InvenTree frontend URL(s)
# Example: CORS_ALLOWED_ORIGINS=https://inventree.yourcompany.com,https://app.inventree.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# AG-UI / DevUI Configuration
# -----------------------------------------------------------------------------
DEVUI_ENABLED=true
DEVUI_PORT=3000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_WF1_DIAGNOSTICS=true
FEATURE_WF2_SEQUENTIAL=true
FEATURE_WF3_CONCURRENT=true
FEATURE_WF4_PROCUREMENT=true
FEATURE_WF5_CPQ=true
FEATURE_WF6_INCOMING_DOCS=true
FEATURE_WF8_LOOKUP=true
FEATURE_REFLECTION_MIDDLEWARE=true
