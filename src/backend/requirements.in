# AI Dependencies
# Microsoft Agent Framework - the ai/ package targets the b251120 beta API (later 1.x
# releases rename ChatAgent). Only the pieces the code imports are pinned: core provides
# agent_framework (+ .azure / .devui); the devui distribution provides agent_framework_devui.
agent-framework-core==1.0.0b251120
agent-framework-devui==1.0.0b251120
aiofiles                                # Async file IO (ai infrastructure stores)
aiohttp                                 # Voice gateway websocket relay
numpy                                   # Embedding math (ai agents/semantic cache)
google-api-python-client                # Gmail integration (ai email tools)
google-auth                             # Gmail integration auth
tenacity                                # Retry policies (ai InvenTree client)
azure-ai-documentintelligence>=1.0.0    # Azure Document Intelligence
azure-identity>=1.15.0                  # Azure Identity
azure-search-documents                  # Azure AI Search integration
httpx                                   # Cohere Embed v4 wire + retry middleware (attachment RAG, R5)
google-genai                            # Gemini Embedding 2 via Vertex AI (media RAG, R0)
pgvector                                # Postgres vector columns for the RAG system of record
openai>=1.12.0                          # OpenAI SDK
# M1 pin ledger (plan of record §9.7 / GR-26): app code imports these, so they are
